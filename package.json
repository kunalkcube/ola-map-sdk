{
  "name": "ola-map-sdk",
  "version": "2.0.0",
  "description": "Lightweight, zero-dependency TypeScript SDK for Ola Maps — Places, Routing, Roads, Geofencing, Elevation, Tiles, Street View, OAuth 2.0, MapLibre, Next.js & React",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./maplibre": {
      "import": {
        "types": "./dist/maplibre/index.d.ts",
        "default": "./dist/maplibre/index.js"
      },
      "require": {
        "types": "./dist/maplibre/index.d.cts",
        "default": "./dist/maplibre/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:pkg": "publint --strict && attw --pack --profile node16",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:pkg",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ola",
    "maps",
    "sdk",
    "ola-map-sdk",
    "ola maps",
    "ola maps api",
    "ola maps sdk",
    "typescript",
    "zero-dependency",
    "maplibre",
    "nextjs",
    "react",
    "geocoding",
    "routing",
    "geofencing",
    "elevation",
    "streetview",
    "places api",
    "distance matrix",
    "snap to road",
    "oauth2"
  ],
  "author": "Kunal Kongkan Kashyap",
  "license": "MIT",
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0",
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^3.1.4",
    "happy-dom": "^17.4.6",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunalkcube/ola-map-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/kunalkcube/ola-map-sdk/issues"
  },
  "homepage": "https://github.com/kunalkcube/ola-map-sdk#readme"
}
